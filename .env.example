# QA Hub iframe에서 현재 페이지 경로를 자동으로 기록할 때만 설정합니다.
NEXT_PUBLIC_QA_HUB_ORIGIN=https://qa-agent-hub-rust.vercel.app

# 임시 준비 중 화면. 이 브랜치는 기본적으로 켜져 있고, off로 설정하면 기존 사이트가 표시됩니다.
SITE_MAINTENANCE_MODE=on

# 롤링페이퍼 저장용 서버 전용 환경 변수입니다. NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
KNUD_MESSAGES_SUPABASE_URL=
KNUD_MESSAGES_SUPABASE_SERVICE_ROLE_KEY=
KNUD_MESSAGES_RATE_LIMIT_SECRET=
